<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040A07"
    android:clipChildren="false">

    <com.mistick.launcher.ui.NebulaView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="64dp">

            <!-- ===== HEADER ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:clipChildren="false"
                android:paddingTop="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/logo_box">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/kic_play_arrow" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.02"
                                android:text="@string/brand_first"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/brand_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.02"
                                android:text="@string/brand_second"
                                android:textColor="#00C896"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/inter_medium"
                            android:letterSpacing="0.03"
                            android:textColor="#66FFFFFF"
                            android:textSize="6.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="-3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_extralight"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.04"
                        android:textColor="#FFFFFF"
                        android:textSize="38sp" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:letterSpacing="0.02"
                        android:textColor="#80FFFFFF"
                        android:textSize="8.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/status_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/glass_pill"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/net_icon"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:alpha="0.8"
                            android:importantForAccessibility="no"
                            android:src="@drawable/kic_wifi" />

                        <TextView
                            android:id="@+id/net_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="#CCFFFFFF"
                            android:textSize="7.5sp" />

                        <View
                            android:layout_width="0.5dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"
                            android:background="#26FFFFFF" />

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"
                            android:alpha="0.6"
                            android:importantForAccessibility="no"
                            android:src="@drawable/kic_bluetooth" />

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"
                            android:alpha="0.8"
                            android:importantForAccessibility="no"
                            android:src="@drawable/kic_settings" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/avatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/avatar_ring"
                        android:focusable="true"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="K"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== POLECANE title + dots ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:letterSpacing="-0.01"
                    android:text="@string/section_featured"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="244dp"
                    android:layout_marginBottom="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hero_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="#73FFFFFF"
                        android:textSize="7.5sp" />

                    <LinearLayout
                        android:id="@+id/hero_dots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== HERO + QUICK ACCESS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="235dp"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/hero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/hero_shape"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/hero_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/hero_art" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_fade_left" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/hero_fade_bottom" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_sheen" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/hero_badge_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:background="@drawable/rounded_soft"
                                android:importantForAccessibility="no"
                                android:padding="2dp"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/hero_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/inter_medium"
                                android:textColor="#B3FFFFFF"
                                android:textSize="7.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/hero_overline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:letterSpacing="0.2"
                            android:text="@string/hero_overline"
                            android:textAllCaps="true"
                            android:textColor="#00C896"
                            android:textSize="7sp" />

                        <TextView
                            android:id="@+id/hero_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.035"
                            android:maxWidth="320dp"
                            android:maxLines="1"
                            android:textColor="#FFFFFF"
                            android:textSize="36sp" />

                        <TextView
                            android:id="@+id/hero_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/inter_regular"
                            android:lineSpacingMultiplier="1.3"
                            android:maxWidth="280dp"
                            android:textColor="#B3FFFFFF"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:clipChildren="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/hero_open"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/pill_white"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/kic_play_arrow"
                                    android:tint="#000000" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/inter_semibold"
                                    android:text="@string/hero_open"
                                    android:textColor="#000000"
                                    android:textSize="9sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/hero_info"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/glass_pill"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp">

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:alpha="0.7"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/kic_info" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="@string/hero_info"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="9sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/hero_all"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/glass_pill"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="14dp">

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:alpha="0.7"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/kic_apps" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/inter_medium"
                                    android:text="@string/hero_all"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <!-- Quick access panel -->
                <LinearLayout
                    android:layout_width="228dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/glass"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/section_quick"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_medium"
                            android:text="@string/quick_hint"
                            android:textColor="#73FFFFFF"
                            android:textSize="6.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/qa_settings"
                            layout="@layout/item_quick_tile"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/qa_search"
                            layout="@layout/item_quick_tile"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/qa_display"
                            layout="@layout/item_quick_tile"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <!-- Volume -->
                    <LinearLayout
                        android:id="@+id/volume_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/glass_tile"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="7dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:alpha="0.85"
                                android:importantForAccessibility="no"
                                android:src="@drawable/kic_volume_up" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_medium"
                                android:text="@string/volume"
                                android:textColor="#D9FFFFFF"
                                android:textSize="8sp" />

                            <TextView
                                android:id="@+id/volume_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_semibold"
                                android:fontFeatureSettings="tnum"
                                android:textColor="#B3FFFFFF"
                                android:textSize="7.5sp" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/volume_track"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="5dp"
                            android:clipChildren="false">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/track" />

                            <View
                                android:id="@+id/volume_fill"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/accent_gradient" />

                            <View
                                android:id="@+id/volume_thumb"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/thumb"
                                android:elevation="2dp"
                                android:outlineSpotShadowColor="#00C896"
                                android:outlineAmbientShadowColor="#00C896" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/volume_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="#66FFFFFF"
                            android:textSize="6.5sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/row_airplay"
                        layout="@layout/item_status_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="#12FFFFFF" />

                    <include
                        android:id="@+id/row_storage"
                        layout="@layout/item_status_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== MY APPS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/section_my_apps"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/my_apps_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="#80FFFFFF"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-48dp"
                android:layout_marginEnd="-48dp"
                android:clipChildren="false">

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/my_apps_row"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="48dp" />

                <View
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="@drawable/edge_fade" />
            </FrameLayout>

            <!-- ===== ALL APPS ===== -->
            <TextView
                android:id="@+id/all_apps_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/section_all_apps"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/all_apps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-48dp"
                android:layout_marginEnd="-48dp"
                android:clipChildren="false">

                <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/all_apps_row"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="48dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="48dp" />

                <View
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="@drawable/edge_fade" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== FOOTER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/footer_fade"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="22dp"
        android:paddingEnd="48dp"
        android:paddingBottom="15dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@drawable/footer_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/footer_hints"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/footer_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textColor="#59FFFFFF"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>