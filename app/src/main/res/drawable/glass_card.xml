<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#3DFFFFFF" android:centerColor="#2440916C" android:endColor="#2E1B4D3E" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#1CFFFFFF" android:centerColor="#0BFFFFFF" android:endColor="#08FFFFFF" />
            <stroke android:width="0.5dp" android:color="#1FFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
