<?xml version="1.0" encoding="utf-8"?>
<!-- Header of HomeFragment (inflated in HomeFragment.onInflateTitleView):
     search orb + title on the left, live clock and date on the right. -->
<com.mistick.launcher.HomeHeaderView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin_horizontal"
    android:paddingTop="@dimen/header_padding_top"
    android:paddingEnd="@dimen/screen_margin_horizontal"
    android:paddingBottom="@dimen/header_padding_bottom">

    <androidx.leanback.widget.SearchOrbView
        android:id="@+id/header_search_orb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/search_hint"
        android:nextFocusDown="@null" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/header_greeting"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_header_title" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/header_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_clock"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/header_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_date" />
    </LinearLayout>
</com.mistick.launcher.HomeHeaderView>
