<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="@dimen/settings_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/screen_margin_vertical"
        android:paddingBottom="@dimen/screen_margin_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_settings_title"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_show_system"
            style="@style/SettingsItem"
            android:text="@string/settings_show_system" />

        <Switch
            android:id="@+id/switch_show_all"
            style="@style/SettingsItem"
            android:text="@string/settings_show_all" />

        <Switch
            android:id="@+id/switch_banners"
            style="@style/SettingsItem"
            android:text="@string/settings_banners" />

        <Button
            android:id="@+id/btn_default_home"
            style="@style/SettingsItem"
            android:text="@string/settings_default_home" />

        <Button
            android:id="@+id/btn_system_settings"
            style="@style/SettingsItem"
            android:text="@string/shortcut_system_settings" />

        <TextView
            android:id="@+id/text_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_card_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/settings_privacy"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_card_label" />
    </LinearLayout>
</ScrollView>
